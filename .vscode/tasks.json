{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "typescript",
      "tsconfig": "tsconfig.json",
      "option": "watch",
      "problemMatcher": [
        "$tsc-watch"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "tsc: watch - tsconfig.json"
    },
    {
      "label": "build-and-minify-ts",
      "type": "shell",
      "command": "npx esbuild ${file} --bundle --minify --outfile=dist/${fileBasenameNoExtension}.min.js",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
