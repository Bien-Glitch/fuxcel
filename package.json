{
  "name": "fuxcel",
  "author": {
    "name": "Bien Nwinate",
    "email": "biennwinate@gmail.com"
  },
  "type": "module",
  "version": "2.1.0",
  "description": "A powerful, lightweight, standalone, zero-dependency JavaScript library for form validation and fluent chainable DOM manipulation.",
  "main": "dist/js/fuxcel.js",
  "module": "dist/js/fuxcel.esm.js",
  "types": "dist/js/fuxcel.d.ts",
  "files": [
    "icon.png",
    "dist/",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/js/fuxcel.esm.js",
      "require": "./dist/js/fuxcel.cjs.js",
      "types": "./dist/js/fuxcel.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "dev": "rollup -c -w"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.5.0",
    "esbuild": "^0.25.4",
    "magic-string": "^0.30.21",
    "rollup": "^4.60.1",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "regexpp": "^3.2.0"
  }
}
