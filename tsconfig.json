{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "rootDir": "src/ts",
    "outDir": "dist/js",
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "removeComments": false,
    "useDefineForClassFields": true
  },
  "exclude": [
    "dist/*/**",
    "node_modules"
  ]
}
