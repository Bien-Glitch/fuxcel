{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "rootDir": "src/ts",
    "outDir": "dist/js",
    "strict": true,
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,
    "removeComments": false,
    "useDefineForClassFields": true,
    // Module resolution for your structure:
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "src/ts/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
